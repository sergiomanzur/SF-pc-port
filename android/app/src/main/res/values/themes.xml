<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SyphonFilter" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/sf_bg_dark</item>
        <item name="android:navigationBarColor">@color/sf_bg_dark</item>
        <item name="android:windowBackground">@color/sf_bg_dark</item>
    </style>

    <style name="Theme.SyphonFilter.Fullscreen" parent="Theme.SyphonFilter">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Tactical Agency Splash Screen Theme -->
    <style name="Theme.SyphonFilter.Splash" parent="Theme.SyphonFilter.Fullscreen">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/sf_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
    </style>
</resources>
