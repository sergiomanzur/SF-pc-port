<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/graphics_settings"
            android:textColor="@color/sf_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Aspect Ratio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/aspect_ratio"
            android:textColor="@color/sf_text_primary"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/rg_aspect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_aspect_adaptive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/aspect_adaptive"
                android:textColor="@color/sf_text_primary" />

            <RadioButton
                android:id="@+id/rb_aspect_4_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/aspect_4_3"
                android:textColor="@color/sf_text_primary" />
        </RadioGroup>

        <!-- FPS Limit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fps_limit"
            android:textColor="@color/sf_text_primary"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/sp_fps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/sf_primary" />

        <!-- Switches -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_vsync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="@string/vsync"
            android:textColor="@color/sf_text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_volumetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/volumetric_effects"
            android:textColor="@color/sf_text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_skyboxes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/custom_skyboxes"
            android:textColor="@color/sf_text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="@color/sf_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/controls_settings"
            android:textColor="@color/sf_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_touch_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="@string/touch_overlay"
            android:textColor="@color/sf_text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_touch_haptics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/touch_haptics"
            android:textColor="@color/sf_text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_vibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/controller_vibration"
            android:textColor="@color/sf_text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="@color/sf_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cheats_menu"
            android:textColor="@color/sf_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_cheat_weapons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/all_weapons"
            android:textColor="@color/sf_text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_cheat_oneshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/one_shot_kills"
            android:textColor="@color/sf_text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_cheat_weak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/weak_enemies"
            android:textColor="@color/sf_text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_cheat_movie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/movie_theater"
            android:textColor="@color/sf_text_primary" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/sf_primary"
            android:text="@string/save_settings"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
